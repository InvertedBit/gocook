package views

import "github.com/invertedbit/gocook/views/partials"
import "github.com/invertedbit/gocook/viewmodels"

templ Layout(
    layoutModel *viewmodels.LayoutViewModel,
) {
    switch layoutModel.LayoutType {
    case viewmodels.LayoutFull:
        @FullLayout(layoutModel) {
            { children... }
        }
    case viewmodels.LayoutBodyOnly:
        @BodyOnlyLayout(layoutModel) {
            { children... }
        }
    default:
        @FullLayout(layoutModel) {
            { children... }
        }
    }
}

templ PartialLayout(
    layoutModel *viewmodels.LayoutViewModel,
) {
    <header id="header" hx-swap-oob="true">
        if !layoutModel.IsError {
            @partials.Navbar(layoutModel.Navbar)
        }
    </header>
    { children... }
}

templ BodyOnlyLayout(
    layoutModel *viewmodels.LayoutViewModel,
) {
    <body class="bg-gray-200 text-gray-800 dark:bg-gray-800 dark:text-gray-200">
        <div class="flex flex-col min-h-screen">
            <header id="header">
                if !layoutModel.IsError {
                    @partials.Navbar(layoutModel.Navbar)
                }
            </header>
            <main class="container mx-auto p-4 flex-grow">
                { children... }
            </main>
            <footer class="footer p-4 bg-neutral text-neutral-content footer-center">
                <div>
                    <p>Copyright © { layoutModel.CopyrightYear } - All right reserved by GoCook</p>
                </div>
            </footer>
        </div>
    </body>
}

templ FullLayout(
    layoutModel *viewmodels.LayoutViewModel,
) {
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <title>GoCook - {layoutModel.Page}</title>
            <link href="/css/theme.css" rel="stylesheet" />
            <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.6/dist/htmx.min.js"></script>
            <script src="https://unpkg.com/hyperscript.org@0.9.14"></script>
            <link
                href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css"
                rel="stylesheet"
            />

        </head>
        <body>
            <div class="flex flex-col min-h-screen">
                <header>
                    if !layoutModel.IsError {
                        @partials.Navbar(layoutModel.Navbar)
                    }
                </header>
                <main class="container mx-auto p-4 flex-grow">
                    { children... }
                </main>
                <footer class="footer p-4 bg-neutral text-neutral-content footer-center">
                    <div>
                        <p>Copyright © { layoutModel.CopyrightYear } - All right reserved by GoCook</p>
                    </div>
                </footer>
            </div>
        </body>
    </html>
}

